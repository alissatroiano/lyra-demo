# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Stripe Credentials & Price IDs
# All four are required for payments. Checkout returns a clear error rather than
# calling Stripe with a missing or placeholder price id.
STRIPE_SECRET_KEY=
# These must be PRICE ids (price_...), not product ids (prod_...). Checkout
# passes them to line_items[].price, which rejects a product id.
STRIPE_PROD_KEY_1= # Price ID for Instructor Demo / Educator Pro (monthly)
STRIPE_PROD_KEY_2= # Price ID for Educator Yearly

# Optional retention incentive. Leave blank to show the promo code field at
# checkout so instructors can enter a code you hand out. Set it to a Stripe
# coupon id to apply that discount automatically to every checkout instead.
STRIPE_COUPON_ID=

# Webhook signing secret from the Stripe dashboard endpoint config (whsec_...).
# The webhook rejects every request unless this is set — it is the only thing
# proving an event actually came from Stripe. Never commit the real value.
STRIPE_WEBHOOK_SECRET=

